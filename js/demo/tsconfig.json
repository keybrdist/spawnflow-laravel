{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@spawnflow-dx/react-shadcn": [
        "../react-shadcn/src/index.ts"
      ],
      "@spawnflow-dx/core": [
        "../core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../react-shadcn/src",
    "../core/src"
  ]
}